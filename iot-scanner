# Module 3: Firmware analysis (binwalk + credential/secret string scan)
# ----------------------------------------------------------------------------
class FirmwareAnalyzer:
    def __init__(self, filepath, quiet=False):
        self.filepath = filepath
        self.quiet = quiet

    def run_binwalk(self, report):
        log(f"Firmware: running binwalk on {self.filepath}", self.quiet)
        try:
            proc = subprocess.run(
                ["binwalk", self.filepath],
                capture_output=True, text=True, timeout=180,
            )
        except FileNotFoundError:
            report.add(
                "INFO", "firmware-analysis", "binwalk not installed",
                "binwalk is required for filesystem/signature analysis "
                "but was not found on PATH.",
                "Install binwalk (apt install binwalk / pip install "
                "binwalk) to enable this module.",
            )
            return
        except subprocess.TimeoutExpired:
            report.add(
                "INFO", "firmware-analysis", "binwalk timed out",
                f"binwalk did not complete within the timeout for "
                f"{self.filepath}.",
                "Re-run manually on a large image; consider increasing "
                "the timeout for big firmware files.",
            )
            return

        output = proc.stdout.strip()
        if output:
            interesting = [
                line for line in output.splitlines()
                if re.search(r'(?i)filesystem|squashfs|jffs2|cramfs|'
                              r'certificate|private key|compressed', line)
            ]
            report.add(
                "INFO", "firmware-analysis", "binwalk signature scan complete",
                "binwalk identified embedded structures in the firmware "
                "image (filesystems, compressed regions, and/or "
                "certificates).",
                "Extract identified filesystems (`binwalk -e`) for deeper "
                "manual review of init scripts and configs.",
                evidence="\n".join(interesting[:25]) or output[:1000],
            )
        else:
            report.add(
                "LOW", "firmware-analysis", "binwalk found no signatures",
                "No recognizable file signatures were found in the "
                "image. It may be encrypted, compressed with a custom "
                "scheme, or not a firmware image.",
                "Verify the file is a raw firmware dump; try `binwalk -E` "
                "for entropy analysis to check for encryption.",
            )

    @staticmethod
    def _extract_ascii_strings(data, min_len=4):
        """Pure-Python fallback equivalent to the `strings` utility, used
        if the `strings` binary isn't available on the host."""
        pattern = re.compile(b'[\x20-\x7e]{%d,}' % min_len)
        return pattern.findall(data)

    def extract_strings_and_scan(self, report):
        log(f"Firmware: extracting strings from {self.filepath}", self.quiet)
        try:
            with open(self.filepath, 'rb') as f:
                data = f.read()
        except OSError as e:
            report.add(
                "INFO", "firmware-analysis", "Could not read firmware file",
                f"Failed to open {self.filepath}: {e}",
                "Verify the path and file permissions.",
            )
            return

        # Prefer the real `strings` binary if present (faster on huge
        # images); otherwise use the pure-Python fallback above.
        lines = None
        try:
            proc = subprocess.run(
                ["strings", "-n", "4", self.filepath],
                capture_output=True, text=True, timeout=120,
            )
            lines = [l.encode() for l in proc.stdout.splitlines()]
        except (FileNotFoundError, subprocess.TimeoutExpired):
            lines = self._extract_ascii_strings(data)

        found_any = False
        for pattern, label, severity in CRED_PATTERNS:
            matches = set()
            for line in lines:
                m = pattern.search(line)
                if m:
                    matches.add(line[:120].decode('utf-8', errors='replace'))
                if len(matches) >= 5:
                    break
            if matches:
                found_any = True
                report.add(
                    severity, "firmware-analysis", label,
                    f"Firmware string analysis matched a pattern "
                    f"consistent with: {label.lower()}.",
                    "Remove hardcoded secrets from firmware; use "
                    "per-device provisioning, secure elements, or "
                    "runtime-injected credentials instead.",
                    evidence="; ".join(list(matches)[:5]),
                )

        if not found_any:
            report.add(
                "INFO", "firmware-analysis", "No obvious hardcoded secrets found",
                "String-pattern scan did not match common credential, "
                "key, or endpoint patterns. This does not rule out "
                "obfuscated or encrypted secrets.",
                "Consider entropy analysis and manual review for "
                "obfuscated credential storage.",
            )


