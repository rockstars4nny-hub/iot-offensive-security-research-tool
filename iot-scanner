    22:   ("SSH", "remote-shell"),
    23:   ("Telnet", "cleartext-remote-shell"),
    80:   ("HTTP", "web"),
    443:  ("HTTPS", "web-tls"),
    554:  ("RTSP", "video-stream"),
    5000: ("UPnP/HTTP-Alt", "web"),
    5760: ("MAVLink-TCP", "mavlink"),
    7070: ("RTSP-Alt", "video-stream"),
    8000: ("HTTP-Alt", "web"),
    8080: ("HTTP-Proxy", "web"),
    8554: ("RTSP-Alt2", "video-stream"),
    8883: ("MQTT-TLS", "iot-messaging"),
    1883: ("MQTT", "cleartext-iot-messaging"),
    9999: ("Misc-IoT-Debug", "debug"),
    14550: ("MAVLink-UDP", "mavlink"),
    18570: ("MAVLink-UDP-Alt", "mavlink"),
}

# Regex patterns run against firmware strings to catch hardcoded secrets.
# Each entry: (compiled pattern, human label, severity)
CRED_PATTERNS = [
    (re.compile(rb'-----BEGIN (RSA|DSA|EC|OPENSSH) PRIVATE KEY-----'),
     "SSH/TLS private key embedded in firmware", "CRITICAL"),
    (re.compile(rb'(?i)root:\$?[0-9a-z$./]*:0:0:'),
     "Root /etc/passwd or /etc/shadow entry with password hash", "HIGH"),
    (re.compile(rb'(?i)(pass(word)?|pwd)\s*[:=]\s*[\'"]?[^\s\'"]{4,32}'),
     "Hardcoded password string", "HIGH"),
    (re.compile(rb'(?i)(api[_-]?key|apikey|access[_-]?key)\s*[:=]\s*[\'"]?[A-Za-z0-9_\-]{8,64}'),
     "Hardcoded API key", "HIGH"),
    (re.compile(rb'(?i)(secret|token|bearer)\s*[:=]\s*[\'"]?[A-Za-z0-9_\-\.]{8,64}'),
     "Hardcoded secret/token", "HIGH"),
    (re.compile(rb'(?i)https?://[a-z0-9.\-]+\.(amazonaws|aliyuncs|myqcloud|azure|cloudfront)\.[a-z]{2,}\S*'),
     "Cloud service endpoint in firmware", "MEDIUM"),
    (re.compile(rb'(?i)mqtt://[^\s\'"]+'),
     "Cleartext MQTT broker endpoint", "MEDIUM"),
    (re.compile(rb'(?i)wpa[_-]?(psk|passphrase)\s*[:=]\s*[\'"]?[^\s\'"]{4,64}'),
     "Hardcoded WiFi PSK/passphrase", "HIGH"),
]

# Bluetooth SIG-assigned 16-bit UUIDs all sit inside this 128-bit template
# (0000XXXX-0000-1000-8000-00805F9B34FB). Anything that DOESN'T match it is
# a vendor-custom UUID -- more likely to be a proprietary data/control
# channel worth manual review than a standard, publicly-documented GATT
# service (Battery Service, Device Information, etc).
_STANDARD_BLE_UUID_RE = re.compile(
    r'^0000[0-9a-f]{4}-0000-1000-8000-00805f9b34fb$', re.IGNORECASE
)


def is_standard_ble_uuid(uuid_str):
    return bool(_STANDARD_BLE_UUID_RE.match(uuid_str))


# Byte patterns that suggest a live interactive shell prompt on UART.
SHELL_PROMPT_PATTERNS = [
    re.compile(rb'BusyBox'),
    re.compile(rb'[#\$>]\s*$'),
    re.compile(rb'(?i)login\s*:'),
    re.compile(rb'(?i)username\s*:'),
    re.compile(rb'U-Boot'),
]


def now_iso():
    return datetime.now(timezone.utc).isoformat()


# ----------------------------------------------------------------------------
# Findings / Report
# ----------------------------------------------------------------------------
class Finding:
    _counter = 0

    def __init__(self, severity, category, title, description, remediation,
                 device_type=None, interface=None, evidence=None):
        Finding._counter += 1
        self.id = f"F-{Finding._counter:04d}"
        self.severity = severity  # CRITICAL / HIGH / MEDIUM / LOW / INFO
        self.category = category
        self.title = title
        self.description = description
        self.remediation = remediation
        self.device_type = device_type
        self.interface = interface
        self.evidence = evidence
        self.timestamp = now_iso()

    def to_dict(self):
        return {
            "id": self.id,
            "severity": self.severity,
            "category": self.category,
            "title": self.title,
            "description": self.description,
            "remediation": self.remediation,
            "device_type": self.device_type,
            "interface": self.interface,
            "evidence": self.evidence,
            "timestamp": self.timestamp,
        }


class Report:
    def __init__(self, targets):
        self.started_at = now_iso()
        self.targets = targets
        self.findings = []

    def add(self, *args, **kwargs):
        f = Finding(*args, **kwargs)
        self.findings.append(f)
        return f

    def to_dict(self):
        summary = {"CRITICAL": 0, "HIGH": 0, "MEDIUM": 0, "LOW": 0, "INFO": 0}
        for f in self.findings:
            summary[f.severity] = summary.get(f.severity, 0) + 1
        return {
            "tool": TOOL_NAME,
            "version": TOOL_VERSION,
            "safety_notice": SAFETY_BANNER,
            "started_at": self.started_at,
            "finished_at": now_iso(),
            "targets": self.targets,
            "summary": summary,
            "findings": [f.to_dict() for f in self.findings],
        }


def log(msg, quiet=False):
    """Verbose/progress output. Never goes to stdout when --quiet is set,
    so quiet mode's stdout stays pure JSON."""
    if not quiet:
        print(f"[*] {msg}", file=sys.stderr)


# ----------------------------------------------------------------------------
# Module 1 + 2: UART auto-baud detection, shell detection, firmware dump
# ----------------------------------------------------------------------------
class UARTScanner:
    def __init__(self, port, baud_list=None, timeout=2.0, quiet=False):
        self.port = port
        self.baud_list = baud_list or COMMON_BAUD_RATES
        self.timeout = timeout
        self.quiet = quiet

    def _open(self, baud):
        return serial.Serial(
            port=self.port, baudrate=baud, timeout=self.timeout,
            bytesize=serial.EIGHTBITS, parity=serial.PARITY_NONE,
            stopbits=serial.STOPBITS_ONE,
        )

    def scan_baud_rates(self, report):
        """Try each common baud rate, send a newline, and look for a
        coherent / printable response. Returns the ser handle + baud on
        success (caller is responsible for closing it), or (None, None)."""
        if serial is None:
            report.add(
                "INFO", "dependency", "pyserial not installed",
                "pyserial is required for UART operations but is not installed.",
                "pip install pyserial", interface=self.port,
            )
            return None, None

        for baud in self.baud_list:
            log(f"UART: trying {self.port} @ {baud} baud", self.quiet)
            try:
                ser = self._open(baud)
            except serial.SerialException as e:
                # Permission denied, device busy, or port doesn't exist.
                # Same error will repeat for every baud rate, so bail out
                # of the whole scan rather than looping uselessly.
                report.add(
                    "INFO", "uart", "Unable to open serial port",
                    f"Could not open {self.port}: {e}",
                    "Check device path, permissions (dialout group / udev "
                    "rules), and that no other process holds the port.",
                    interface=self.port,
                )
                return None, None
            except OSError as e:
                report.add(
                    "INFO", "uart", "Serial port OS error",
                    f"OS error opening {self.port}: {e}",
                    "Verify the device is connected and not in use.",
                    interface=self.port,
                )
                return None, None

            try:
                ser.reset_input_buffer()
                ser.write(b'\r\n')
                time.sleep(0.3)
                data = ser.read(512)

                if data and self._looks_valid(data):
                    report.add(
                        "INFO", "uart", "UART baud rate identified",
                        f"Device responds coherently at {baud} baud on "
                        f"{self.port}.",
                        "Disable or restrict physical UART access on "
                        "production units (remove header, disable console).",
                        interface=f"{self.port}@{baud}",
                        evidence=self._safe_preview(data),
                    )
                    return ser, baud
            except serial.SerialException as e:
                log(f"UART: read error at {baud} baud: {e}", self.quiet)
            finally:
                if not (ser and ser.is_open and ser.baudrate == baud
                        and data and self._looks_valid(data)):
                    ser.close()

        report.add(
            "LOW", "uart", "No responsive baud rate found",
            f"None of {self.baud_list} produced a coherent response on "
            f"{self.port}. The console may be disabled, wired "
            "differently, or using an uncommon baud rate.",
            "No action needed if this is intentional (console disabled). "
            "If unexpected, verify wiring (TX/RX/GND) and try additional "
            "baud rates.",
            interface=self.port,
        )
        return None, None

    @staticmethod
    def _looks_valid(data):
        # Mostly-printable bytes, or a recognizable boot/shell pattern,
        # indicate the baud rate is correct (garbage baud = garbage bytes).
        printable = sum(1 for b in data if 32 <= b <= 126 or b in (9, 10, 13))
        if len(data) == 0:
            return False
        if printable / len(data) > 0.6:
            return True
        return any(p.search(data) for p in SHELL_PROMPT_PATTERNS)

    @staticmethod
    def _safe_preview(data, limit=200):
        return data[:limit].decode('utf-8', errors='replace')

    def detect_shell(self, ser, report):
        """Given an open serial handle at the correct baud, probe for an
        interactive shell (e.g. hitting Enter during U-Boot autoboot, or a
        login-less BusyBox console). Logs CRITICAL if shell access is
        gained, since this typically means full root on the device."""
        log(f"UART: probing for shell access on {ser.port}", self.quiet)
        try:
            ser.reset_input_buffer()
            ser.write(b'\r\n')
            time.sleep(0.2)
            ser.write(b'help\r\n')
            time.sleep(0.5)
            resp = ser.read(1024)

            if resp and any(p.search(resp) for p in SHELL_PROMPT_PATTERNS):
                report.add(
                    "CRITICAL", "uart", "Interactive shell obtained via UART",
                    "An interactive command shell (BusyBox/U-Boot/login "
                    "prompt) was reached over the UART console without "
                    "any authentication barrier being enforced from this "
                    "physical interface.",
                    "Disable the UART console in production firmware, "
                    "require authentication on serial console, or "
                    "physically remove/disable the debug header before "
                    "shipping.",
                    interface=ser.port,
                    evidence=self._safe_preview(resp),
                )
                return True
            else:
                report.add(
                    "INFO", "uart", "No shell reached via UART",
                    "UART is responsive but no interactive shell prompt "
                    "was obtained with a basic probe.",
                    "None required. Consider deeper interaction (boot "
                    "interrupt, credential brute force) only with "
                    "explicit authorization.",
                    interface=ser.port,
                )
                return False
        except serial.SerialException as e:
            report.add(
                "INFO", "uart", "UART disconnected during shell probe",
                f"Lost connection to {ser.port}: {e}",
                "Check physical connection and retry.",
                interface=ser.port,
            )
            return False

    def attempt_firmware_dump(self, ser, report, out_path):
        """Attempt to pull firmware off the device using common shell-level
        dump primitives. This only works if detect_shell() already
        confirmed shell access. JTAG/SWD-based extraction is NOT automated
        here: identifying and using JTAG/SWD pins requires a hardware
        probe (e.g. J-Link, JTAGulator) and physical pin mapping, which is
        out of scope for a software-only tool. This function documents
        that as an INFO finding rather than pretending to do it."""
        candidate_commands = [
            b'dump_image\r\n',
            b'cat /dev/mtd0 > /tmp/mtd0.bin && echo DUMP_OK\r\n',
            b'cat /proc/mtd\r\n',
        ]
        dumped = False
        collected = b''

        for cmd in candidate_commands:
            try:
                ser.reset_input_buffer()
                ser.write(cmd)
                time.sleep(1.0)
                resp = ser.read(4096)
                collected += resp
                if b'DUMP_OK' in resp or (b'dump' in cmd and len(resp) > 64):
                    dumped = True
            except serial.SerialException as e:
                report.add(
                    "INFO", "uart", "Device disconnected during firmware dump",
                    f"Lost connection while attempting '{cmd.strip()}': {e}",
                    "Reconnect and retry; consider a slower dump method.",
                    interface=ser.port,
                )
                break

        if dumped:
            try:
                with open(out_path, 'wb') as f:
                    f.write(collected)
                report.add(
                    "CRITICAL", "firmware-extraction",
                    "Firmware extracted via UART shell command",
                    "Firmware/flash contents were readable via an "
                    "unauthenticated shell-level command over UART, "
                    "confirming no protection against physical dumping.",
                    "Disable UART shell access in production, or enforce "
                    "authentication before shell commands are accepted.",
                    interface=ser.port,
                    evidence=f"saved to {out_path} ({len(collected)} bytes)",
                )
            except OSError as e:
                report.add(
                    "INFO", "firmware-extraction", "Could not save dump",
                    f"Dump data was captured but could not be written to "
                    f"{out_path}: {e}",
                    "Check output path permissions and disk space.",
                    interface=ser.port,
                )
        else:
            report.add(
                "INFO", "firmware-extraction",
                "Firmware dump via UART not confirmed",
                "Common dump commands did not return a recognizable "
                "firmware image over the shell.",
                "Manual extraction may still be possible via SPI flash "
                "chip-off or a JTAG/SWD probe (hardware tool required; "
                "not automatable in software). Inspect the board for "
                "unpopulated flash/debug headers.",
                interface=ser.port,
                evidence=self._safe_preview(collected),
            )


